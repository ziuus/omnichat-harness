# ─────────────────────────────────────────────────────────────
# OmniChat Harness — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# API Authentication
# Key that AI agents use to connect to OmniChat (any string you choose)
OMNI_API_KEY=omni-local-dev-key

# Database
DATABASE_URL=./data/omnichat.db

# Redis (for BullMQ task queue)
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# MODE 3: MIDDLEMAN AGENT CONFIGURATION
# Choose ONE of the options below
# ─────────────────────────────────────────────────────────────

# Option A: Local Ollama
OMNI_MIDDLEMAN_TYPE=ollama
OMNI_MIDDLEMAN_BASE_URL=http://localhost:11434/v1
OMNI_MIDDLEMAN_MODEL=llama3.1:70b

# Option B: OpenAI API
# OMNI_MIDDLEMAN_TYPE=openai
# OMNI_MIDDLEMAN_API_KEY=sk-...
# OMNI_MIDDLEMAN_MODEL=gpt-4o

# Option C: Anthropic API
# OMNI_MIDDLEMAN_TYPE=anthropic
# OMNI_MIDDLEMAN_API_KEY=sk-ant-...
# OMNI_MIDDLEMAN_MODEL=claude-opus-4-5

# Option D: Any OpenAI-compatible endpoint (LM Studio, Together, etc.)
# OMNI_MIDDLEMAN_TYPE=openai-compatible
# OMNI_MIDDLEMAN_BASE_URL=http://localhost:1234/v1
# OMNI_MIDDLEMAN_API_KEY=lm-studio
# OMNI_MIDDLEMAN_MODEL=mistral-7b

# ─────────────────────────────────────────────────────────────
# BROWSER ENGINE
# ─────────────────────────────────────────────────────────────

# Max concurrent browser contexts (each uses ~200MB RAM)
BROWSER_POOL_SIZE=5

# Use Browserbase for cloud browsers (anti-detection)
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Human-like delay range (ms) between browser actions
BROWSER_MIN_DELAY_MS=500
BROWSER_MAX_DELAY_MS=2000

# ─────────────────────────────────────────────────────────────
# PROVIDER SESSION PATHS (where cookies are stored)
# ─────────────────────────────────────────────────────────────
SESSION_STORAGE_PATH=./data/sessions
SESSION_ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# ─────────────────────────────────────────────────────────────
# DASHBOARD
# ─────────────────────────────────────────────────────────────
DASHBOARD_PORT=3001
